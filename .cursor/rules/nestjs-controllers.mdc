# NestJS Controllers Pattern

## Controller Structure

NestJS controllers should follow this pattern:

```typescript
import {
  Controller,
  Get,
  Post,
  Put,
  Delete,
  Param,
  Body,
  Query,
  UseGuards,
  ParseIntPipe,
  HttpStatus,
} from "@nestjs/common";
import { ApiTags, ApiOperation, ApiResponse, ApiParam } from "@nestjs/swagger";
import { I18n, I18nService } from "nestjs-i18n";

import { ResponseWrapper, buildResponse, ResponseCode } from "@/types";
import { JwtAuthGuard } from "@/auth/guards/jwt-auth.guard";
import { RolesGuard } from "@/auth/guards/roles.guard";
import { Roles } from "@/auth/decorators/roles.decorator";
import { CurrentUser } from "@/auth/decorators/current-user.decorator";
import { UserEntity } from "@/auth/entities/user.entity";

import { ModuleService } from "./module.service";
import {
  CreateModuleDto,
  UpdateModuleDto,
  QueryModuleDto,
  ModuleResponseDto,
} from "./dto";
import {
  CreateModuleApiBody,
  CreateModuleApiResponse,
  UpdateModuleApiResponse,
  DeleteModuleApiResponse,
} from "./docs";
```

## Route Definitions

### Basic Routes

```typescript
@ApiTags("Modules")
@Controller("modules")
export class ModuleController {
  constructor(
    private readonly moduleService: ModuleService,
    private readonly i18n: I18nService,
  ) {}
}
```

### Resource Routes with Parameters

```typescript
@Controller("modules")
export class ModuleController {
  @Get(":id")
  @ApiParam({ name: "id", type: Number, description: "Module ID" })
  async findOne(
    @Param("id", ParseIntPipe) id: number,
  ): Promise<ResponseWrapper<ModuleResponseDto>> {
    const data = await this.moduleService.findOne(id);
    return buildResponse({
      data,
      code: ResponseCode.OK,
      message: this.i18n.t("module.found", {
        lang: I18nContext.current().lang,
      }),
    });
  }
}
```

### Nested Routes

```typescript
@Controller("accounts/:accountId/modules")
export class ModuleController {
  @Get()
  async findByAccount(
    @Param("accountId", ParseIntPipe) accountId: number,
  ): Promise<ResponseWrapper<ModuleResponseDto[]>> {
    const data = await this.moduleService.findByAccount(accountId);
    return buildResponse({ data, code: ResponseCode.OK });
  }
}
```

## HTTP Methods

### GET Routes

```typescript
@Get()
@ApiOperation({ summary: "List all modules" })
@ApiResponse({ 
  status: 200, 
  description: "Modules retrieved successfully",
  type: [ModuleResponseDto]
})
async findAll(
  @Query() query: QueryModuleDto,
): Promise<ResponseWrapper<ModuleResponseDto[]>> {
  const data = await this.moduleService.findAll(query);
  return buildResponse({ 
    data, 
    code: ResponseCode.OK,
    message: this.i18n.t("module.listRetrieved", {
      lang: I18nContext.current().lang,
    }),
  });
}

@Get(":id")
@ApiOperation({ summary: "Get module by ID" })
@ApiResponse({ 
  status: 200, 
  description: "Module retrieved successfully",
  type: ModuleResponseDto
})
@ApiResponse({ status: 404, description: "Module not found" })
async findOne(
  @Param("id", ParseIntPipe) id: number,
): Promise<ResponseWrapper<ModuleResponseDto>> {
  const data = await this.moduleService.findOne(id);
  return buildResponse({ 
    data, 
    code: ResponseCode.OK,
    message: this.i18n.t("module.found", {
      lang: I18nContext.current().lang,
    }),
  });
}
```

### POST Routes

```typescript
@Post()
@UseGuards(JwtAuthGuard)
@ApiOperation({ summary: "Create new module" })
@ApiBody(CreateModuleApiBody)
@ApiResponse(CreateModuleApiResponse)
@ApiResponse({ status: 400, description: "Bad request - invalid data" })
@ApiResponse({ status: 401, description: "Unauthorized" })
@ApiResponse({ status: 409, description: "Conflict - module already exists" })
async create(
  @Body() createDto: CreateModuleDto,
  @CurrentUser() user: UserEntity,
): Promise<ResponseWrapper<ModuleResponseDto>> {
  const data = await this.moduleService.create(createDto, user.id);
  return buildResponse({
    data,
    code: ResponseCode.CREATED,
    message: this.i18n.t("module.created", {
      lang: I18nContext.current().lang,
    }),
  });
}
```

### PUT Routes

```typescript
@Put(":id")
@UseGuards(JwtAuthGuard)
@ApiOperation({ summary: "Update module" })
@ApiBody({ type: UpdateModuleDto })
@ApiResponse(UpdateModuleApiResponse)
@ApiResponse({ status: 400, description: "Bad request - invalid data" })
@ApiResponse({ status: 401, description: "Unauthorized" })
@ApiResponse({ status: 404, description: "Module not found" })
async update(
  @Param("id", ParseIntPipe) id: number,
  @Body() updateDto: UpdateModuleDto,
  @CurrentUser() user: UserEntity,
): Promise<ResponseWrapper<ModuleResponseDto>> {
  const data = await this.moduleService.update(id, updateDto, user.id);
  return buildResponse({
    data,
    code: ResponseCode.OK,
    message: this.i18n.t("module.updated", {
      lang: I18nContext.current().lang,
    }),
  });
}
```

### DELETE Routes

```typescript
@Delete(":id")
@UseGuards(JwtAuthGuard)
@ApiOperation({ summary: "Delete module" })
@ApiResponse(DeleteModuleApiResponse)
@ApiResponse({ status: 401, description: "Unauthorized" })
@ApiResponse({ status: 404, description: "Module not found" })
async remove(
  @Param("id", ParseIntPipe) id: number,
  @CurrentUser() user: UserEntity,
): Promise<ResponseWrapper<null>> {
  await this.moduleService.remove(id, user.id);
  return buildResponse({
    data: null,
    code: ResponseCode.OK,
    message: this.i18n.t("module.deleted", {
      lang: I18nContext.current().lang,
    }),
  });
}
```

## Authentication & Authorization

### JWT Authentication

```typescript
@UseGuards(JwtAuthGuard)
@Post()
async create(@Body() createDto: CreateModuleDto, @CurrentUser() user: UserEntity) {
  // User is authenticated and available
}
```

### Role-based Authorization

```typescript
@UseGuards(JwtAuthGuard, RolesGuard)
@Roles(Role.ADMIN, Role.MODERATOR)
@Delete(":id")
async remove(@Param("id", ParseIntPipe) id: number) {
  // User has required roles
}
```

## Parameter Validation

### Path Parameters

```typescript
@Get(":id")
async findOne(@Param("id", ParseIntPipe) id: number) {
  // id is guaranteed to be a number
}
```

### Query Parameters

```typescript
@Get()
async findAll(@Query() query: QueryModuleDto) {
  // query is validated according to DTO
}
```

### Custom Pipes

```typescript
@Get(":slug")
async findOneBySlug(@Param("slug", SlugPipe) slug: string) {
  // slug is processed by custom pipe
}
```

## Response Patterns

### Success Response

```typescript
return buildResponse({
  data: result,
  code: ResponseCode.OK,
  message: this.i18n.t("module.success", {
    lang: I18nContext.current().lang,
  }),
});
```

### Created Response

```typescript
return buildResponse({
  data: result,
  code: ResponseCode.CREATED,
  message: this.i18n.t("module.created", {
    lang: I18nContext.current().lang,
  }),
});
```

### Empty Response

```typescript
return buildResponse({
  data: null,
  code: ResponseCode.OK,
  message: this.i18n.t("module.deleted", {
    lang: I18nContext.current().lang,
  }),
});
```

## Error Handling

Controller should let service layer handle business logic errors, but can handle HTTP-specific errors:

```typescript
@Post()
async create(@Body() createDto: CreateModuleDto) {
  try {
    const data = await this.moduleService.create(createDto);
    return buildResponse({ data, code: ResponseCode.CREATED });
  } catch (error) {
    // HTTP-specific error handling if needed
    throw error; // Let exception filter handle it
  }
}
```

## Status Codes

Use appropriate HTTP status codes:

- `200 OK` - Successful GET, PUT, DELETE
- `201 Created` - Successful POST
- `204 No Content` - Successful DELETE with no response body
- `400 Bad Request` - Validation errors
- `401 Unauthorized` - Authentication required
- `403 Forbidden` - Insufficient permissions
- `404 Not Found` - Resource not found
- `409 Conflict` - Resource already exists
- `422 Unprocessable Entity` - Semantic validation errors

## File Upload

```typescript
@Post("upload")
@UseInterceptors(FileInterceptor("file"))
async uploadFile(
  @UploadedFile() file: Express.Multer.File,
  @Body() uploadDto: UploadFileDto,
): Promise<ResponseWrapper<FileResponseDto>> {
  const data = await this.moduleService.uploadFile(file, uploadDto);
  return buildResponse({ data, code: ResponseCode.OK });
}
```

## Batch Operations

```typescript
@Post("batch")
@ApiOperation({ summary: "Create multiple modules" })
async createBatch(
  @Body() createBatchDto: CreateBatchModuleDto,
): Promise<ResponseWrapper<ModuleResponseDto[]>> {
  const data = await this.moduleService.createBatch(createBatchDto.items);
  return buildResponse({ data, code: ResponseCode.CREATED });
}
```

## Pagination

```typescript
@Get()
async findAll(
  @Query() query: QueryModuleDto,
): Promise<ResponseWrapper<PaginatedResponseDto<ModuleResponseDto>>> {
  const { items, total, page, limit } = await this.moduleService.findAll(query);
  return buildResponse({
    data: {
      items,
      pagination: {
        page,
        limit,
        total,
        totalPages: Math.ceil(total / limit),
      },
    },
    code: ResponseCode.OK,
  });
}
```

## Search and Filtering

```typescript
@Get("search")
async search(
  @Query() searchDto: SearchModuleDto,
): Promise<ResponseWrapper<ModuleResponseDto[]>> {
  const data = await this.moduleService.search(searchDto);
  return buildResponse({ data, code: ResponseCode.OK });
}
```

