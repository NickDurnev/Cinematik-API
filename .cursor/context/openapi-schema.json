{
  "openapi": "3.0.0",
  "info": {
    "title": "Cinematik API",
    "description": "Cinematik API - Movie management platform backend with collaborative pair mode feature",
    "version": "0.1.1",
    "contact": {
      "name": "API Support",
      "email": "support@cinematik.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    },
    {
      "url": "https://api.cinematik.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "App",
      "description": "General application endpoints"
    },
    {
      "name": "Auth",
      "description": "Authentication and authorization"
    },
    {
      "name": "Movies",
      "description": "Movie catalog management"
    },
    {
      "name": "Reviews",
      "description": "Movie reviews"
    },
    {
      "name": "Profile",
      "description": "User profile management"
    },
    {
      "name": "Pairs",
      "description": "Collaborative movie selection with friends (Tinder-style swiping)"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "API Root",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIResponse_String"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register new user",
        "operationId": "signup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User login",
        "operationId": "signin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigninDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/pairs/requests": {
      "post": {
        "tags": [
          "Pairs"
        ],
        "summary": "Send a pair request to another user",
        "operationId": "sendPairRequest",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendPairRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pair request sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairRequestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error or duplicate request"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "get": {
        "tags": [
          "Pairs"
        ],
        "summary": "Get pending incoming pair requests",
        "operationId": "getPendingRequests",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pending requests retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PairRequestWithRequester"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pairs/requests/{id}": {
      "patch": {
        "tags": [
          "Pairs"
        ],
        "summary": "Accept or reject a pair request",
        "operationId": "respondToPairRequest",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Pair request ID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondPairRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request responded to successfully"
          },
          "400": {
            "description": "Bad request - request already responded to or expired"
          },
          "403": {
            "description": "Forbidden - not authorized to respond to this request"
          },
          "404": {
            "description": "Request not found"
          }
        }
      }
    },
    "/pairs": {
      "get": {
        "tags": [
          "Pairs"
        ],
        "summary": "Get all user pairs",
        "operationId": "getUserPairs",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pairs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PairWithOtherUser"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pairs/{id}": {
      "delete": {
        "tags": [
          "Pairs"
        ],
        "summary": "Remove a pair",
        "operationId": "deletePair",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Pair ID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pair removed successfully"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Pair not found"
          }
        }
      }
    },
    "/pairs/{pairId}/sessions": {
      "post": {
        "tags": [
          "Pairs"
        ],
        "summary": "Create a new swiping session",
        "operationId": "createSession",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "description": "Pair ID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - active session already exists"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Pair not found"
          }
        }
      }
    },
    "/pairs/{pairId}/sessions/active": {
      "get": {
        "tags": [
          "Pairs"
        ],
        "summary": "Get active session for a pair",
        "operationId": "getActiveSession",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "description": "Pair ID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active session retrieved successfully"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Pair not found"
          }
        }
      }
    },
    "/pairs/{pairId}/sessions/{sessionId}/filters": {
      "patch": {
        "tags": [
          "Pairs"
        ],
        "summary": "Propose filters for a session",
        "operationId": "proposeFilters",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeFiltersDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filters proposed successfully"
          },
          "400": {
            "description": "Bad request - invalid filters or session status"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/pairs/{pairId}/sessions/{sessionId}/filters/accept": {
      "post": {
        "tags": [
          "Pairs"
        ],
        "summary": "Accept proposed filters and start swiping",
        "operationId": "acceptFilters",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filters accepted, session is now active"
          },
          "400": {
            "description": "Bad request - filters not proposed or invalid session status"
          },
          "403": {
            "description": "Forbidden - not part of this pair or cannot accept own filters"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/pairs/{pairId}/sessions/{sessionId}/end": {
      "post": {
        "tags": [
          "Pairs"
        ],
        "summary": "End a session manually",
        "operationId": "endSession",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session ended successfully"
          },
          "400": {
            "description": "Bad request - session already completed"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/pairs/sessions/{sessionId}/next": {
      "get": {
        "tags": [
          "Pairs"
        ],
        "summary": "Get next content to swipe on",
        "operationId": "getNextContent",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next content retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - session not active"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/pairs/sessions/{sessionId}/swipe": {
      "post": {
        "tags": [
          "Pairs"
        ],
        "summary": "Record a swipe",
        "operationId": "recordSwipe",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordSwipeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Swipe recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwipeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - session not active"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/pairs/{pairId}/matches": {
      "get": {
        "tags": [
          "Pairs"
        ],
        "summary": "Get all matches for a pair",
        "operationId": "getMatches",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "movie",
                "tv"
              ]
            },
            "description": "Filter by media type"
          },
          {
            "name": "markedWatched",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by watched status"
          }
        ],
        "responses": {
          "200": {
            "description": "Matches retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchesResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Pair not found"
          }
        }
      }
    },
    "/pairs/{pairId}/matches/{matchId}/watched": {
      "patch": {
        "tags": [
          "Pairs"
        ],
        "summary": "Mark a match as watched or unwatched",
        "operationId": "markMatchAsWatched",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "pairId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "watched": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "watched"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Match updated successfully"
          },
          "403": {
            "description": "Forbidden - not part of this pair"
          },
          "404": {
            "description": "Match not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "APIResponse_String": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "example": "Hello from Cinematik API!"
          },
          "code": {
            "type": "string",
            "example": "OK"
          },
          "message": {
            "type": "string",
            "example": "Request successful"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-10T08:31:14.094Z"
          }
        }
      },
      "SignupDto": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecurePassword123"
          }
        }
      },
      "SigninDto": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecurePassword123"
          }
        }
      },
      "SendPairRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username of the user to invite",
            "example": "john_doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email of the user to invite",
            "example": "john@example.com"
          }
        },
        "description": "Either username or email required"
      },
      "RespondPairRequestDto": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "reject"
            ],
            "example": "accept"
          }
        }
      },
      "CreateSessionDto": {
        "type": "object",
        "required": [
          "mediaType"
        ],
        "properties": {
          "mediaType": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ],
            "example": "movie"
          }
        }
      },
      "ProposeFiltersDto": {
        "type": "object",
        "properties": {
          "yearMin": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100,
            "example": 2000
          },
          "yearMax": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100,
            "example": 2024
          },
          "genreIds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              28,
              12,
              878
            ],
            "description": "Array of TMDB genre IDs"
          }
        }
      },
      "RecordSwipeDto": {
        "type": "object",
        "required": [
          "tmdbId",
          "direction"
        ],
        "properties": {
          "tmdbId": {
            "type": "integer",
            "example": 550,
            "description": "TMDB ID of the content being swiped"
          },
          "direction": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "example": "right"
          }
        }
      },
      "PairRequestResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 201
          },
          "message": {
            "type": "string",
            "example": "Pair request sent successfully"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "requester_id": {
                "type": "string",
                "format": "uuid"
              },
              "requested_id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "accepted",
                  "rejected"
                ]
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "PairRequestWithRequester": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requester": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "picture": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PairWithOtherUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "otherUser": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "picture": {
                "type": "string"
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 201
          },
          "message": {
            "type": "string",
            "example": "Session created successfully"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "pair_id": {
                "type": "string",
                "format": "uuid"
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "movie",
                  "tv"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "filter_pending",
                  "active",
                  "completed"
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
